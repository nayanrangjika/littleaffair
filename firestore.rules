rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection Rules for blogs & comments
    match /blogs/{blogId} {
      allow read, create, update, delete: if true;

      match /comments/{commentId} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
